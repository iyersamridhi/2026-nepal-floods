# xAI Grok — get key at https://console.x.ai/
# Used only when article content CHANGES (hash diff skips unchanged pages)
XAI_API_KEY=

# Optional: Twitter/X API v2 for authority tweets
TWITTER_BEARER_TOKEN=

# Grok model (default: grok-3-latest)
GROK_MODEL=grok-3-latest

# Set to 1 to force re-summarize everything even if content unchanged
FORCE_RESCrape=0
